# ==============================================================================
# SNKB 3D Printing Business - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your real credentials for local development.
# DO NOT commit real secrets (.env is ignored by version control).

# ------------------------------------------------------------------------------
# Supabase Database Configuration
# ------------------------------------------------------------------------------
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Optional service role key for privileged admin operations:
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Supabase Storage bucket name for uploaded STL geometries (default: 'models')
SUPABASE_STORAGE_BUCKET=models

# ------------------------------------------------------------------------------
# Admin Security & Fulfillment Queue Protection
# ------------------------------------------------------------------------------
# Secret token/passcode required to unlock /admin queue and authorize /api/admin/* endpoints:
ADMIN_ACCESS_TOKEN=snkb-admin-secret-2026

# ------------------------------------------------------------------------------
# Resend Transactional Email Configuration
# ------------------------------------------------------------------------------
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
SNKB_EMAIL_FROM_NAME=SNKB 3D Studio
# Set to '0' to disable outbound email during local testing:
SNKB_EMAIL_ENABLED=1

# ------------------------------------------------------------------------------
# Public Site / App URL
# ------------------------------------------------------------------------------
# Deployed origin or local URL used to build public tracking links in emails:
PUBLIC_SITE_URL=http://localhost:3000
SNKB_PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Server / Port Configuration
# ------------------------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------------------------
# INR Pricing Engine (Pan-India FDM service rates)
# ------------------------------------------------------------------------------
# Retail PLA+ material rate (₹/g). Storefront promise: "from ₹2.00/g".
SNKB_MATERIAL_RATE_PER_G=2.0
# Machine-time rate (₹/print-hour).
SNKB_MACHINE_RATE_PER_HOUR=25
# Sustained throughput assumption (g/hour) used to estimate print time.
SNKB_PRINT_GRAMS_PER_HOUR=12
# Fixed service charge (₹): order handling, slicing setup, QA, customer support.
SNKB_SERVICE_FEE=39
# Print-labor rate (₹/g): monitoring, support removal, finishing.
SNKB_MAKING_RATE_PER_G=1.0
# Fixed handling charge (₹): box, cushioning, labels, dispatch handling.
SNKB_HANDLING_FEE=25
# Small-print minimum order value (₹).
SNKB_MIN_ORDER_VALUE=149

# ------------------------------------------------------------------------------
# Pan-India Delivery Calculator (courier-style slabs)
# ------------------------------------------------------------------------------
# Box + cushioning buffer added to the bare print weight (g).
SNKB_DELIVERY_PACKAGING_G=150
# First-500 g slab by zone (₹): metro hubs vs rest of India.
SNKB_DELIVERY_METRO_BASE=59
SNKB_DELIVERY_ROI_BASE=79
# Each additional 500 g slab by zone (₹).
SNKB_DELIVERY_METRO_EXTRA=25
SNKB_DELIVERY_ROI_EXTRA=35
# Print-total (₹) at or above which delivery is free.
SNKB_FREE_SHIPPING_THRESHOLD=499

# ------------------------------------------------------------------------------
# UPI Payment & QR Configuration
# ------------------------------------------------------------------------------
# Primary Payee VPA / UPI ID (default: snkbstudio@ybl)
SNKB_UPI_ID=snkbstudio@ybl
# Primary Merchant / Payee Display Name (default: SHUBHAM BUNDELE)
SNKB_UPI_NAME=SHUBHAM BUNDELE

# ------------------------------------------------------------------------------
# Courier Integrations (Shiprocket & Delhivery Direct)
# ------------------------------------------------------------------------------
# Default workshop pickup PIN code (Indore, MP):
SNKB_PICKUP_PINCODE=452001

# Shiprocket (Recommended: Unified Delhivery, Blue Dart, DTDC, Xpressbees in one API)
# Sign up at https://app.shiprocket.in/ to get API credentials
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Or provide pre-generated API token directly:
# SHIPROCKET_TOKEN=

# Delhivery Direct API (Alternative)
# Sign up at https://one.delhivery.com/
DELHIVERY_API_TOKEN=


# ------------------------------------------------------------------------------
# Telegram Bot Configuration (VS Code Update Notifications)
# ------------------------------------------------------------------------------
# Get your bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Chat ID where updates should be sent (e.g., channel ID or user ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# VS Code update check interval in milliseconds (default: 3600000 = 1 hour)
VSCODE_CHECK_INTERVAL_MS=3600000
