---
export interface Props {
  product: {
    id: string;
    name: string;
    slug?: string;
    dimensionsDisplay?: string;
    stlUrl?: string;
    modelUrl?: string;
    accentStlUrl?: string;
    multiPart?: {
      base: string;
      accent: string;
      assemblyType: string;
    };
    defaultColors?: {
      primary: string;
      accent: string;
    };
    image?: string;
  };
}

const { product } = Astro.props;

const stlUrl = product.stlUrl || product.modelUrl || `/models/${product.id}.stl`;
const baseStlUrl = product.multiPart?.base || `/models/${product.id}-base.stl`;
const accentStlUrl = product.multiPart?.accent || product.accentStlUrl || `/models/${product.id}-accent.stl`;
const assemblyKind = product.assemblyType || (product.multiPart ? 'multi-part' : 'single-piece');
const canExplode = product.canExplode ?? !!product.multiPart;
const partCount = product.partCount ?? product.partsCount ?? 1;
const hasMultiPart = !!product.multiPart && canExplode;
const defaultPrimary = product.defaultColors?.primary || '#FF6500';
const defaultAccent = product.defaultColors?.accent || '#00FF66';
const lockBadge = assemblyKind === 'print-in-place'
  ? '🔒 PRINT-IN-PLACE MONOLITH — Hinges print pre-assembled; item cannot be exploded.'
  : '🔒 SINGLE-PIECE SOLID PRINT — Item cannot be exploded.';
---

<div
  class="catalog-model-card relative w-full h-[200px] sm:h-[220px] bg-[#0c0e12] overflow-hidden cut-sm border border-zinc-800/80 group-hover:border-zinc-700 transition"
  data-product-id={product.id}
  data-stl={stlUrl}
  data-base-stl={hasMultiPart ? baseStlUrl : ''}
  data-accent-stl={hasMultiPart ? accentStlUrl : ''}
  data-multipart={hasMultiPart ? 'true' : 'false'}
  data-can-explode={canExplode ? 'true' : 'false'}
  data-assembly-kind={assemblyKind}
  data-part-count={String(partCount)}
  data-lock-badge={lockBadge}
  data-primary-color={defaultPrimary}
  data-accent-color={defaultAccent}
  data-poster={product.image}
>
  {/* Solid 3D Canvas Container with Snapshot Layer */}
  <div class="catalog-canvas-container relative w-full h-full flex items-center justify-center bg-[#0c0e12] overflow-hidden">
    {/* High-Resolution Solid 3D Image Snapshot generated by Shared Offscreen Renderer */}
    <img
      class="catalog-snapshot-img w-full h-full object-contain pointer-events-none select-none transition-opacity duration-300"
      src={product.image || ''}
      alt={`${product.name} — 3D solid model preview`}
      style="display: block; width: 100%; height: 100%; z-index: 1;"
      loading="lazy"
    />

    {/* Live Interactive WebGL Mount (activated on hover or swatch click) */}
    <div class="catalog-live-mount absolute inset-0 pointer-events-auto" style="display: none; z-index: 5;">
      <canvas class="catalog-3d-canvas w-full h-full block cursor-grab active:cursor-grabbing outline-none" style="display: block; width: 100%; height: 100%;"></canvas>
    </div>
  </div>

  {/* Loading Spinner Overlay */}
  <div class="catalog-loading-overlay absolute inset-0 flex flex-col items-center justify-center bg-[#0c0e12]/80 z-20 transition-opacity duration-300 pointer-events-none opacity-0">
    <div class="w-8 h-8 border-2 border-[#EA580C] border-t-transparent rounded-full animate-spin"></div>
    <span class="telemetry text-[10px] text-zinc-400 mt-2 font-mono tracking-widest">LOADING 3D MESH...</span>
  </div>

  {/* Top Badge Overlay */}
  <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5 z-10 pointer-events-none">
    <span class="w-2 h-2 rounded-full bg-[#00FF66] animate-pulse"></span>
    <span class="telemetry text-[9px] text-zinc-300 font-mono tracking-wider bg-black/70 px-2 py-0.5 rounded border border-zinc-800 backdrop-blur-xs">
      SOLID 3D PREVIEW · {canExplode ? `EXPLODABLE ${partCount} PARTS` : assemblyKind === 'print-in-place' ? '🔒 PRINT-IN-PLACE' : '🔒 SINGLE-PIECE'}
    </span>
  </div>

  <div class="absolute top-2.5 right-2.5 z-10 pointer-events-none text-[10px] font-mono text-zinc-300 bg-zinc-950/80 backdrop-blur-xs px-2 py-0.5 rounded border border-zinc-700/60 shadow">
    PLA+ 1.24g/cm³
  </div>

  {/* Bottom Controls Bar: Swatch Pills & Multi-Part Explode Button */}
  <div class="absolute bottom-2.5 inset-x-2.5 flex items-center justify-between gap-2 z-10 pointer-events-auto">
    {/* 4 Clickable Filament Swatch Pills */}
    <div class="flex items-center gap-1.5 bg-zinc-950/80 backdrop-blur-md px-2 py-1 rounded-full border border-zinc-800/80 shadow-lg">
      <span class="text-[9px] font-mono text-zinc-400 mr-0.5 hidden sm:inline">Color:</span>
      <button
        type="button"
        class="swatch-pill w-4.5 h-4.5 rounded-full border border-white/20 hover:scale-115 transition-transform cursor-pointer relative"
        style="background-color: #EA580C;"
        data-color="#EA580C"
        title="Bambu Orange"
        aria-label="Switch to Bambu Orange"
      ></button>
      <button
        type="button"
        class="swatch-pill w-4.5 h-4.5 rounded-full border border-white/20 hover:scale-115 transition-transform cursor-pointer relative"
        style="background-color: #2E7D32;"
        data-color="#2E7D32"
        title="Tough Olive Green"
        aria-label="Switch to Tough Olive Green"
      ></button>
      <button
        type="button"
        class="swatch-pill w-4.5 h-4.5 rounded-full border border-white/20 hover:scale-115 transition-transform cursor-pointer relative"
        style="background-color: #1E2024;"
        data-color="#1E2024"
        title="Matte Charcoal"
        aria-label="Switch to Matte Charcoal"
      ></button>
      <button
        type="button"
        class="swatch-pill w-4.5 h-4.5 rounded-full border border-white/20 hover:scale-115 transition-transform cursor-pointer relative"
        style="background-color: #0284C7;"
        data-color="#0284C7"
        title="Industrial Cyan"
        aria-label="Switch to Industrial Cyan"
      ></button>
    </div>

    {/* Explode Parts Toggle for Every Catalog Card */}
    <button
      type="button"
      class={`explode-parts-btn min-h-[40px] text-[10px] font-mono font-semibold px-3 py-1 rounded-full backdrop-blur-md shadow-lg cursor-pointer flex items-center gap-1.5 border transition-all ${canExplode ? 'bg-zinc-950/85 text-zinc-200 border-zinc-700/80 hover:text-[#00FF66] hover:border-[#00FF66]' : 'bg-zinc-900/90 text-zinc-500 border-zinc-800 opacity-70 cursor-not-allowed'}`}
      data-exploded="false"
      disabled={!canExplode}
      title={canExplode ? 'Explode/Assemble multi-part pieces in 3D space' : lockBadge}
    >
      <svg class="w-3 h-3 text-[#00FF66] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
      </svg>
      <span class="explode-label">{canExplode ? 'Explode Parts' : '🔒 Cannot Explode'}</span>
    </button>
  </div>

  {/* Hidden noscript fallback preserving static image reference */}
  <noscript>
    <img src={product.image} alt={`${product.name} — 3D printed model`} class="w-full h-full object-cover" />
  </noscript>
</div>

<script>
  import { initCatalog3D } from './catalogModelPreview.js';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCatalog3D);
  } else {
    initCatalog3D();
  }
  document.addEventListener('astro:page-load', initCatalog3D);
</script>
