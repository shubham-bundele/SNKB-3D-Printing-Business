---
/**
 * src/components/FilamentSpineTrack.astro
 *
 * Continuous Animated SVG Filament Extrusion Track running down the page spine.
 * Visually and interactively connects:
 * 01: Hero (Print Stage) -> 02: Process (Pipeline) -> 03: Slicer (Instant Quote) -> 04: Materials (Lab) -> 05: Catalog
 */

const stations = [
  { id: 'hero', target: '#hero', label: '01: PRINT STAGE', short: '01' },
  { id: 'process', target: '#process', label: '02: PIPELINE', short: '02' },
  { id: 'instant-quote', target: '#instant-quote', label: '03: SLICER ARENA', short: '03' },
  { id: 'materials', target: '#materials', label: '04: MATERIAL SPECS', short: '04' },
  { id: 'products', target: '#products', label: '05: NO-AMS CATALOG', short: '05' },
];
---

<nav
  aria-label="Filament Spine Pipeline Navigation"
  class="filament-spine-track hidden xl:flex flex-col items-center fixed left-4 top-24 bottom-16 z-40 select-none pointer-events-auto transition-opacity duration-300"
>
  {/* Spool Feeder Header */}
  <div class="flex flex-col items-center mb-2 group cursor-pointer" title="Continuous Filament Feed: 1.75mm PLA+">
    <div class="w-8 h-8 rounded-full border border-[#FF6500]/60 bg-black/80 flex items-center justify-center shadow-[0_0_12px_rgba(255,101,0,0.35)] group-hover:scale-110 transition-transform">
      <svg class="w-4 h-4 text-[#FF6500] animate-spin" style="animation-duration: 12s;" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <circle cx="12" cy="12" r="9" stroke-width="2" stroke-dasharray="4 2" />
        <circle cx="12" cy="12" r="3" stroke-width="2" />
        <path d="M12 3v3m0 12v3M3 12h3m12 0h3" stroke-width="2" />
      </svg>
    </div>
    <span class="telemetry text-[8px] text-[#FF6500] font-mono mt-1 tracking-widest font-bold">
      FEED 1.75mm
    </span>
  </div>

  {/* SVG Continuous Track with Animated Laser Bead */}
  <div class="relative flex-1 w-6 flex items-center justify-center my-1">
    <svg class="h-full w-4 overflow-visible" preserveAspectRatio="none" viewBox="0 0 16 600">
      <defs>
        <linearGradient id="spineGradient" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#FF6500" stop-opacity="0.8" />
          <stop offset="25%" stop-color="#00FF66" stop-opacity="0.8" />
          <stop offset="50%" stop-color="#00E5FF" stop-opacity="0.8" />
          <stop offset="75%" stop-color="#FF6500" stop-opacity="0.8" />
          <stop offset="100%" stop-color="#00FF66" stop-opacity="0.8" />
        </linearGradient>
      </defs>

      {/* Guide background line */}
      <line x1="8" y1="0" x2="8" y2="600" stroke="#23262f" stroke-width="2" stroke-dasharray="3 3" />

      {/* Glowing extruded filament line */}
      <line
        x1="8"
        y1="0"
        x2="8"
        y2="600"
        stroke="url(#spineGradient)"
        stroke-width="2.5"
        stroke-linecap="round"
        class="spine-extrusion-line"
      />
    </svg>

    {/* Moving Extrusion Bead Pulse */}
    <div class="spine-bead-pulse absolute w-3 h-3 rounded-full bg-[#00FF66] shadow-[0_0_10px_#00FF66] pointer-events-none -translate-x-1/2 left-1/2"></div>

    {/* Waypoint Nodes positioned along the spine */}
    <div class="absolute inset-y-0 flex flex-col justify-between items-center py-4 w-full">
      {stations.map((station) => (
        <a
          href={station.target}
          class="spine-waypoint-node group relative flex items-center justify-center w-6 h-6 rounded-full bg-zinc-950 border border-zinc-700 hover:border-[#FF6500] hover:scale-125 transition-all shadow cursor-pointer"
          data-station-id={station.id}
          title={`Jump to ${station.label}`}
        >
          <span class="w-2 h-2 rounded-full bg-zinc-500 group-hover:bg-[#FF6500] transition-colors"></span>
          
          {/* Tooltip Label expanding to the right */}
          <span class="absolute left-8 px-2 py-1 bg-black/90 text-zinc-300 font-mono text-[9px] rounded border border-zinc-800 shadow-xl whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-opacity z-50 flex items-center gap-1.5">
            <span class="text-[#FF6500] font-bold">▶</span>
            <span>{station.label}</span>
          </span>
        </a>
      ))}
    </div>
  </div>

  {/* Extrusion Nozzle Footer */}
  <div class="flex flex-col items-center mt-2 group cursor-pointer" title="Calibrated 0.4mm Hardened Stainless Steel Nozzle">
    <div class="w-7 h-7 cut-sm border border-[#00FF66]/60 bg-black/80 flex items-center justify-center shadow-[0_0_10px_rgba(0,255,102,0.3)] group-hover:scale-110 transition-transform">
      <svg class="w-3.5 h-3.5 text-[#00FF66]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path d="M12 2v8m-4 4l4 8 4-8H8z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
    <span class="telemetry text-[8px] text-[#00FF66] font-mono mt-1 tracking-widest font-bold">
      NOZZLE 0.4mm
    </span>
  </div>
</nav>

<style>
  @keyframes beadTravel {
    0% {
      top: 5%;
      opacity: 0.2;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      top: 95%;
      opacity: 0.2;
    }
  }

  .spine-bead-pulse {
    animation: beadTravel 6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes lineDash {
    0% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: -120;
    }
  }

  .spine-extrusion-line {
    stroke-dasharray: 8 4;
    animation: lineDash 4s linear infinite;
  }
</style>

<script>
  function initSpineWaypoints() {
    const nodes = document.querySelectorAll<HTMLElement>('.spine-waypoint-node');
    const sections = Array.from(nodes).map((n) => {
      const targetId = n.getAttribute('href')?.replace('#', '') || '';
      return {
        node: n,
        section: document.getElementById(targetId),
      };
    }).filter((s) => s.section !== null);

    window.addEventListener('scroll', () => {
      const scrollPos = window.scrollY + 200;
      sections.forEach(({ node, section }) => {
        if (!section) return;
        const top = section.offsetTop;
        const height = section.offsetHeight;
        if (scrollPos >= top && scrollPos < top + height) {
          node.classList.add('border-[#00FF66]', 'ring-2', 'ring-[#00FF66]/30');
          const dot = node.querySelector('span');
          if (dot) dot.classList.add('bg-[#00FF66]');
        } else {
          node.classList.remove('border-[#00FF66]', 'ring-2', 'ring-[#00FF66]/30');
          const dot = node.querySelector('span');
          if (dot) dot.classList.remove('bg-[#00FF66]');
        }
      });
    }, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSpineWaypoints);
  } else {
    initSpineWaypoints();
  }
  document.addEventListener('astro:page-load', initSpineWaypoints);
</script>
