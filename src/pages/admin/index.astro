---
import AdminLayout from '../../layouts/AdminLayout.astro';
import OrderManagement from '../../components/admin/OrderManagement.jsx';
---

<AdminLayout title="Admin Dashboard — Orders & Profit Analytics | SNKB 3D Studio">
  <div class="max-w-7xl mx-auto space-y-6">
    {/* Page Title & Context Header */}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-zinc-800/80">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span class="text-[11px] font-mono uppercase tracking-wider text-emerald-400 font-semibold">
            Internal Operations Portal
          </span>
        </div>
        <h1 class="text-2xl font-bold text-white tracking-tight">
          Admin Dashboard & Fulfillment Queue
        </h1>
        <p class="text-xs text-zinc-400 mt-1">
          SNKB 3D Studio print farm operations • High-grade PLA+ Material • Pan-India fulfillment queue.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/#instant-quote"
          target="_blank"
          class="px-3.5 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs font-semibold border border-zinc-700 transition flex items-center gap-2"
        >
          <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Test New STL Quote</span>
        </a>
      </div>
    </div>

    {/* Profit Dashboard and Order Management Table */}
    <OrderManagement client:load />
  </div>
</AdminLayout>
