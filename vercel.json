{
  "version": 2,
  "buildCommand": "npm run astro:build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/track/(.*)",
      "destination": "/track/sample/index.html"
    }
  ]
}
